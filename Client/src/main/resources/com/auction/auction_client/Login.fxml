<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Hyperlink?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="344.0"
      prefWidth="347.0"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.auction_client.LoginController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText1"
           text="Login System"
           prefWidth="307.0"
           alignment="CENTER"/>

    <TextField fx:id="txtUsername"
               promptText="Enter username"
               prefWidth="250.0"
               maxWidth="250.0"/>

    <PasswordField fx:id="txtPassword"
                   promptText="Enter password"
                   prefWidth="250.0"
                   maxWidth="250.0"/>

    <Button fx:id="btnLogin"
            text="Login"
            mnemonicParsing="false"
            defaultButton="true"
            onAction="#onLoginButtonClick"/>
    <Hyperlink text="Don't have an account? Register"
               onAction="#onRegisterLinkClick"/>

    <Label fx:id="lblMessage"
           prefWidth="307.0"
           wrapText="true"
           alignment="CENTER"
           textAlignment="CENTER"/>

</VBox>
