<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12"
      prefWidth="400"
      prefHeight="650"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.auction_client.RegisterController">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Create Account"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtFullName"
               promptText="Full name"
               maxWidth="300"/>

    <TextField fx:id="txtUsername"
               promptText="Username"
               maxWidth="300"/>

    <TextField fx:id="txtEmail"
               promptText="Email"
               maxWidth="300"/>

    <PasswordField fx:id="txtPassword"
                   promptText="Password"
                   maxWidth="300"/>

    <PasswordField fx:id="txtConfirmPassword"
                   promptText="Confirm password"
                   maxWidth="300"/>

    <ComboBox fx:id="cbRole"
              promptText="Select account type"
              maxWidth="300"/>

    <Button text="Register"
            onAction="#onRegisterButtonClick"
            prefWidth="150"/>

    <Label fx:id="lblMessage"
           wrapText="true"
           maxWidth="300"/>

    <VBox spacing="6"
          maxWidth="300"
          style="-fx-background-color: #F2F2F2;
                 -fx-background-radius: 8;
                 -fx-padding: 10;">

        <Label text="Registration requirements"
               style="-fx-font-weight: bold; -fx-font-size: 12px;"/>

        <Label text="Username: 4–20 characters, letters, numbers and underscore (_)"
               wrapText="true"
               style="-fx-font-size: 11px; -fx-text-fill: #666666;"/>

        <Label text="Email: Must have a valid email format"
               wrapText="true"
               style="-fx-font-size: 11px; -fx-text-fill: #666666;"/>

        <Label text="Password: At least 8 characters, one uppercase letter, one lowercase letter and one number"
               wrapText="true"
               style="-fx-font-size: 11px; -fx-text-fill: #666666;"/>
    </VBox>

    <Hyperlink text="Already have an account? Login"
               onAction="#onBackToLoginClick"/>

</VBox>
