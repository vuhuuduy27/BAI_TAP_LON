<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12"
      prefWidth="400"
      prefHeight="550"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.auction_client.RegisterController">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Create Account"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtFullName"
               promptText="Full name"
               maxWidth="300"/>

    <TextField fx:id="txtUsername"
               promptText="Username"
               maxWidth="300"/>

    <TextField fx:id="txtEmail"
               promptText="Email"
               maxWidth="300"/>

    <PasswordField fx:id="txtPassword"
                   promptText="Password"
                   maxWidth="300"/>

    <PasswordField fx:id="txtConfirmPassword"
                   promptText="Confirm password"
                   maxWidth="300"/>

    <ComboBox fx:id="cbRole"
              promptText="Select account type"
              maxWidth="300"/>

    <Button text="Register"
            onAction="#onRegisterButtonClick"
            prefWidth="150"/>

    <Label fx:id="lblMessage"
           wrapText="true"
           maxWidth="300"/>

    <Hyperlink text="Already have an account? Login"
               onAction="#onBackToLoginClick"/>

</VBox>
